{
  "name": "torquemach",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate --filter=@torque/db",
    "db:seed": "turbo run db:seed --filter=@torque/db",
    "evals": "turbo run evals --filter=@torque/ai"
  },
  "devDependencies": {
    "turbo": "^2.3.0"
  }
}
